# Public origin of the deployment. Used for canonical URLs, the sitemap and
# robots.txt. Without it those point at a placeholder host.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Optional. Connect a Vercel KV or Upstash Redis store and the leaderboard and
# player rankings become permanent and shared between visitors. Both variables
# are injected automatically when you add the integration in Vercel.
# Without them the game runs fine, but results are held in memory and clear
# whenever the server restarts.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. Only needed for the Drizzle/Postgres path and `npm run db:seed`.
DATABASE_URL=
